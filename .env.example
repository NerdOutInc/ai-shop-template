# Canonical production origin. Set this after choosing the new store domain.
# Checkout callbacks use Vercel's deployment URL when this is unset.
# NEXT_PUBLIC_SITE_URL=https://your-store.example

# Printify PATs expire after one year and cover allowed operations across all account shops.
# Separate tokens do not isolate brands; use separate accounts when isolation is required.
# Server-only Printify credentials. Optional for builds and offline development.
# Runtime scopes: products.read, orders.read; add orders.write only for authorized real fulfillment.
# Use shops.read on a separate setup credential only when discovering the intended shop.
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID= # choose the new owner's Printify API shop; never copy another shop ID

# Supabase Postgres SESSION pooler (port 5432), never transaction pooler 6543.
# Apply the fresh baseline migration to a new, isolated database before accepting payment.
# Runtime role: store_app_runtime. Provision its random password separately; see docs/store-setup.md.
# DATABASE_URL=postgresql://store_app_runtime.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# For Supabase, set the complete PEM CA certificate from Database Settings.
# DATABASE_SSL_CA= # multiline PEM; preserve actual line breaks

# Required for checkout admission. Use an independent random secret (32–256 characters), shared by all replicas.
# CHECKOUT_RATE_LIMIT_SECRET=
# Optional strict JSON overrides; use identical limits on every replica. See docs/checkout-resilience.md.
# CHECKOUT_CAPACITY_LIMITS={"ingress":{"perMinute":60,"burst":30},"status":{"perMinute":120,"burst":20},"stripeRead":{"perMinute":120,"burst":10},"providerRead":{"perMinute":120,"burst":20}}

# Stripe restricted server key recommended. No browser/publishable key is needed.
# STRIPE_SECRET_KEY=rk_test_...
# Required signed webhook endpoint: /api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_...

# Test-mode Stripe payments NEVER create real Printify orders, regardless of this flag.
# Set true when connecting live Stripe keys and ready to fulfill paid orders.
PRINTIFY_FULFILLMENT_ENABLED=false

# Enable only after all migrations, the new shop configuration,
# dedicated runtime token, signed webhook, and recurring worker are configured.
# Publishing is required for storefront browsing and new checkout quotes.
# Apply the fresh baseline and initialize background observations before enabling publishing.
PRINTIFY_PUBLISHING_ENABLED=false
# PRINTIFY_PUBLISHING_API_TOKEN= # products.read + products.write
# PRINTIFY_DRAFTS_API_TOKEN= # separate server-only token: products.read + products.write + uploads.write + catalog.read
# Its catalog.read also serves the read-only blueprint-name lookup under Garment models; names can always be typed by hand.
# PRINTIFY_WEBHOOK_SECRET= # separate random secret, at least 32 characters
# CRON_SECRET= # separate random worker credential, at least 32 characters
# PRINTIFY_MONITOR_SECRET= # separate read-only health credential, at least 32 characters
# Required to serve /feeds/google. Use a separate random password (32–256 characters).
# Set the same password in Merchant Center file-source authentication, username google-merchant.
# GOOGLE_MERCHANT_FEED_PASSWORD=
# Required to serve /feeds/meta. Use a different random password (32–256 characters).
# Set it in Meta's existing catalog source authentication, username meta-catalog.
# Configure and deploy before switching that source; neither feed accepts the other's credentials.
# META_CATALOG_FEED_PASSWORD=
# Public Blob hostname; production and preview use separate stores.
# NEXT_PUBLIC_PRODUCT_IMAGE_BLOB_HOST=STORE.public.blob.vercel-storage.com
# Connect the Blob store in Vercel for automatic SDK authentication.
# BLOB_STORE_ID= # Vercel OIDC, or BLOB_READ_WRITE_TOKEN for an external maintenance process
# PRINTIFY_WEBHOOK_ADMIN_TOKEN= # maintenance only: webhooks.read + webhooks.write

# Enable only after configuring Stripe Tax settings + active registrations.
# The server checks these prerequisites before creating Checkout sessions.
# False means this integration does not collect tax.
STRIPE_TAX_ENABLED=false

# Optional isolated Postgres test database; never use a production database here.
# CHECKOUT_TEST_DATABASE_URL=postgresql://postgres:local-commerce-test@localhost:55479/store_commerce_test
# PUBLISHING_TEST_DATABASE_URL=postgresql://postgres:local-commerce-test@localhost:55479/store_publishing_test
# GARMENTS_TEST_DATABASE_URL=postgresql://postgres:local-commerce-test@localhost:55479/store_garments_test
# SIGNUP_TEST_DATABASE_URL=postgresql://postgres:local-commerce-test@localhost:55479/store_signup_test

# Meta Pixel: configure only after consent/recovery verification and approved account setup.
# The ID is public. This server-side switch defaults off and only enables Vercel Production.
META_PIXEL_ENABLED=false
META_PIXEL_ID=

# Google Merchant Center purchase tracking; enable only in approved Production.
GOOGLE_TAG_ENABLED=false
GOOGLE_TAG_ID=

# Private concept library. Leave disabled until auth, migrations and private storage are configured.
ADMIN_LIBRARY_ENABLED=false
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only owner bootstrap: use a separate random secret of at least 32 characters.
# ADMIN_OWNER_EMAIL=
# ADMIN_SETUP_SECRET=
# SUPABASE_SECRET_KEY=sb_secret_... # owner account provisioning only; never NEXT_PUBLIC_
# PRIVATE_BLOB_READ_WRITE_TOKEN= # dedicated private concept store; never use public mockup credentials
# Auth: disable unrestricted signup; use custom SMTP with an email OTP template ({{ .Token }}).
# Enable native experimental passkeys with the permanent RP domain and explicit allowed origins.
# ADMIN_TEST_DATABASE_URL= # isolated database with Supabase auth schema; never production

# Owner-only shipping reminders. Production only; deploy migration and verify sender before enabling.
ORDER_ALERTS_ENABLED=false
# RESEND_API_KEY= # sending-only key for the verified sender domain; never NEXT_PUBLIC_
# ORDER_ALERT_FROM_EMAIL= # verified Resend sender; recipient comes from storeConfig.supportEmail
# SHIPPING_TEST_DATABASE_URL=postgresql://postgres:local-commerce-test@localhost:55479/store_shipping_test

# GitHub publishing monitor: opt in only after this store is live.
# Repository variable PUBLISHING_MONITOR_ENABLED=true enables the scheduled workflow.
# PRINTIFY_MONITOR_URL=https://your-store.example/api/internal/printify-publishing/health
# PRINTIFY_MONITOR_ASSIGNEE= # optional GitHub login for incident notifications
