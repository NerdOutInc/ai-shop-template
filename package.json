{
  "name": "t-shirt-shop-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && pnpm lint:skills",
    "lint:skills": "python3 -m ruff check --config scripts/skills/ruff.toml .agents/skills/store-*",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "check:structure": "node scripts/check-structure.mjs",
    "check:migrations": "node scripts/check-migration-references.mjs",
    "format:check": "prettier --check . && pnpm format:skills:check",
    "format:skills:check": "prettier --check --ignore-path scripts/skills/.prettierignore \".agents/skills/store-*/**/*.{md,js,mjs,cjs,ts,tsx,json,yaml,yml}\" && python3 -m ruff format --check --config scripts/skills/ruff.toml .agents/skills/store-*",
    "format": "prettier --write . && pnpm format:skills",
    "format:skills": "prettier --write --ignore-path scripts/skills/.prettierignore \".agents/skills/store-*/**/*.{md,js,mjs,cjs,ts,tsx,json,yaml,yml}\" && python3 -m ruff format --config scripts/skills/ruff.toml .agents/skills/store-*",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "icons:generate": "node scripts/branding/generate-icons.mjs",
    "test:branding": "node --test scripts/branding/*.test.mjs",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:architecture": "node --test scripts/architecture/*.test.mjs",
    "test:monitor": "node --test scripts/printify/*.test.mjs",
    "test:skills": "python3 .agents/skills/store-design-concepts/scripts/inspect-print-assets.test.py",
    "test:artwork": "node --conditions=react-server --import tsx --test scripts/artwork/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:publishing": "PUBLISHING_E2E=true playwright test",
    "test:admin:prepare": "tsx e2e/admin/prepare-supabase.ts",
    "test:admin:build": "tsx e2e/prepare-storefront.ts --admin",
    "test:e2e:admin": "ADMIN_E2E=true playwright test",
    "test": "pnpm test:unit && pnpm test:branding && pnpm test:architecture && pnpm test:monitor && pnpm test:skills && pnpm test:artwork && pnpm test:design-agent && pnpm test:template && pnpm test:database",
    "check": "pnpm check:template && pnpm check:structure && pnpm check:migrations && pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "check:all": "pnpm check && pnpm test:stories && pnpm test:admin:prepare && tsx e2e/admin/run-with-config.ts pnpm build && pnpm build-storybook && pnpm test:e2e:prepare && pnpm test:e2e && pnpm test:e2e:publishing && pnpm test:admin:build && pnpm test:e2e:admin",
    "design-agent": "node --conditions=react-server --import tsx scripts/design-agent/run.mjs",
    "test:design-agent": "node --conditions=react-server --import tsx --test scripts/design-agent/*.test.mjs",
    "setup:check": "node --conditions=react-server --import tsx -- scripts/template/setup-check.mjs",
    "check:template": "node scripts/template/check-template.mjs",
    "test:template": "node --conditions=react-server --import tsx --test scripts/template/*.test.mjs",
    "test:database": "node --import tsx scripts/database/run-tests.mjs",
    "test:e2e:prepare": "tsx e2e/prepare-storefront.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript-eslint/utils": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "undici": "8.10.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "next@16.3.6": "patches/next@16.3.6.patch"
    }
  }
}
